<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AirPhotoGarage.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPhotoGarage.Views"
    xmlns:vm="using:AirPhotoGarage.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="vm:SettingsViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24" Spacing="24" MaxWidth="720" HorizontalAlignment="Left">

            <!-- 顶部标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="个性化外观与查看应用信息"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 外观：主题模式 -->
            <StackPanel Spacing="8">
                <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="主题模式"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <RadioButtons Header="选择应用主题"
                                      SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="主题模式">
                            <x:String>跟随系统</x:String>
                            <x:String>浅色</x:String>
                            <x:String>深色</x:String>
                        </RadioButtons>
                        <TextBlock Text="切换主题后立即生效，设置会保存到本地磁盘，下次启动自动恢复。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 照片库位置 -->
            <StackPanel Spacing="8">
                <TextBlock Text="照片库位置" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="当前库根目录"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LibraryRootText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="数据库文件"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DatabasePathText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="新建 database 文件夹..."
                                    Click="OnCreateDatabaseFolderClick" />
                            <Button Content="选择已有文件夹..."
                                    Click="OnChooseLibraryFolderClick" />
                            <Button Content="恢复默认位置"
                                    Click="OnResetLibraryRootClick" />
                        </StackPanel>

                        <TextBlock Text="库目录用于存放导入的照片副本、缩略图与数据库。更改后需重启应用生效，原有照片不会自动迁移。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="8">
                <TextBlock Text="关于" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="应用信息"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="应用名称"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="Air Photo Garage" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="版本"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{x:Bind ViewModel.VersionText, Mode=OneTime}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="数据库路径"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{x:Bind ViewModel.DatabasePathText, Mode=OneTime}"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="照片库根目录"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{x:Bind ViewModel.LibraryRootText, Mode=OneTime}"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 版权 -->
            <StackPanel Spacing="8">
                <TextBlock Text="版权" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock Text="{x:Bind ViewModel.CopyrightText, Mode=OneTime}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="22" />
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
