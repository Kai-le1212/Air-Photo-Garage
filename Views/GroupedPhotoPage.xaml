<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AirPhotoGarage.Views.GroupedPhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPhotoGarage.Views"
    xmlns:vm="using:AirPhotoGarage.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 照片卡片模板：分组页内多处复用（同一页面内 x:Key 引用是安全的） -->
        <DataTemplate x:Key="PhotoCardTpl" x:DataType="vm:PhotoCardViewModel">
            <!-- DataTemplate 根元素必须显式 Width/Height，否则容器坍缩到 0 -->
            <Border Width="240" Height="300"
                    BorderThickness="1" CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Stretch"
                                Padding="8,4"
                                CornerRadius="0,0,0,8"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                Visibility="{x:Bind HasNoInfo, Mode=OneWay}">
                            <TextBlock Text="未提供机型/注册号信息"
                                       Foreground="White"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                        <TextBlock Text="{x:Bind AircraftDisplay, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind MetaDisplay, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind AirportDisplay, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 + 排序 -->
        <Grid Grid.Row="0" Padding="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← 返回"
                    Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                    Click="OnBackClick" />

            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" />

            <ComboBox Grid.Column="2"
                      MinWidth="200"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.SortOptions}"
                      SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}" />
        </Grid>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <!-- 分组列表 -->
            <ScrollViewer Visibility="{x:Bind ViewModel.GroupListVisibility, Mode=OneWay}"
                          Padding="20,0,20,20"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupItemViewModel">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Padding="16,12"
                                    Click="OnGroupClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Value}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind RangeText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind CountText}" />
                                    <FontIcon Grid.Column="2"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE76C;"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 分组详情 -->
            <ScrollViewer Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                          Padding="20,0,20,20"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- 按天分组（注册号页） -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DayGroups, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.DayGroupsVisibility, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayGroup">
                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,8">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind CountText}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,4"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <GridView ItemsSource="{x:Bind Photos}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="OnPhotoClick"
                                              ItemTemplate="{StaticResource PhotoCardTpl}">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                    </GridView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 平铺照片 -->
                    <GridView ItemsSource="{x:Bind ViewModel.Photos, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.FlatPhotosVisibility, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnPhotoClick"
                              ItemTemplate="{StaticResource PhotoCardTpl}">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>
            </ScrollViewer>

            <!-- 空状态 -->
            <TextBlock Margin="24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="{x:Bind ViewModel.EmptyHintVisibility, Mode=OneWay}"
                       Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" />
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                Padding="20,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
