<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AirPhotoGarage.Views.GroupedPhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPhotoGarage.Views"
    xmlns:vm="using:AirPhotoGarage.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            照片卡片模板：分组页内多处复用（同一页面内 x:Key 引用是安全的）。

            卡片上<b>不放任何文字与入口</b>，只留图片 ——
            注册号 / 机型 / 时间 / 机场都挪到日期节点的说明区展示了。
            打开详情有两条路径：
            1) 左键点击卡片 → GridView.ItemClick → OnPhotoClick
            2) 右键卡片 → MenuFlyout「查看详情」→ 打开详情
        -->
        <DataTemplate x:Key="PhotoCardTpl" x:DataType="vm:PhotoCardViewModel">
            <!--
                卡片上【不再印任何文字】：注册号 / 机型 / 拍摄时间 / 机场这些小字
                已统一挪到上方日期节点的说明区展示。卡片只留图片，视觉干净很多。

                DataTemplate 根元素必须显式 Width/Height，否则容器坍缩到 0。
            -->
            <Border Width="240" Height="200"
                    BorderThickness="1" CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    RightTapped="OnCardRightTapped">
                <Grid Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                    <!-- Uniform：完整显示、保持原比例，不裁掉画面边缘 -->
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                    <Border VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Padding="8,4"
                            CornerRadius="0,0,0,8"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            Visibility="{x:Bind HasNoInfo, Mode=OneWay}">
                        <TextBlock Text="未提供机型/注册号信息"
                                   Foreground="White"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 + 排序 -->
        <Grid Grid.Row="0" Padding="20,16,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 第 1 行：返回按钮 + 标题 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← 返回"
                        Visibility="{x:Bind ViewModel.BackButtonVisibility, Mode=OneWay}"
                        Click="OnBackClick" />

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" />
            </Grid>

            <!-- 第 2 行：排序控件。单独一行，避免与长标题抢宽度被挤出可视区 -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,10,0,0"
                        Spacing="12">
                <!-- 列表态：分组排序 -->
                <ComboBox MinWidth="210"
                          Header="分组排序"
                          ItemsSource="{x:Bind ViewModel.GroupSortOptions}"
                          SelectedIndex="{x:Bind ViewModel.GroupSortIndex, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.GroupListSortVisibility, Mode=OneWay}" />

                <!-- 详情态：照片排序（默认按拍摄时间） -->
                <ComboBox MinWidth="210"
                          Header="照片排序"
                          ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.PhotoSortVisibility, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <!-- 分组列表 -->
            <ScrollViewer Visibility="{x:Bind ViewModel.GroupListVisibility, Mode=OneWay}"
                          Padding="20,0,20,20"
                          VerticalScrollBarVisibility="Auto">
                <!-- 分组列表：用 ListView + IsItemClickEnabled，命中测试比 ItemsControl+Button 可靠 -->
                <ListView ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnGroupClick"
                          Padding="0"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,14" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayText}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind RangeText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <!-- 「未填写」兜底行标记 -->
                                        <Border Visibility="{x:Bind MissingBadgeVisibility}"
                                                VerticalAlignment="Center"
                                                Padding="6,0"
                                                CornerRadius="3"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                            <TextBlock Text="待补全"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind CountText}" />
                                <FontIcon Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Glyph="&#xE76C;"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <!--
                中间层：注册号列表（仅机型页）。
                机型是共享概念（一次航展可能十几架同型机），所以必须先下钻到
                具体哪一架飞机（注册号），再看照片。
            -->
            <ScrollViewer Visibility="{x:Bind ViewModel.SubGroupListVisibility, Mode=OneWay}"
                          Padding="20,0,20,20"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.SubGroups, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnSubGroupClick"
                              Padding="0"
                              Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,14" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupItemViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE709;"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayText}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind RangeText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <!-- 「未填写注册号」兜底行标记：提示这批照片补全后即可归组 -->
                                            <Border Visibility="{x:Bind MissingBadgeVisibility}"
                                                    VerticalAlignment="Center"
                                                    Padding="6,0"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                                <TextBlock Text="待补全"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind CountText}" />
                                    <FontIcon Grid.Column="3"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE76C;"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Margin="24"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind ViewModel.SubGroupEmptyHintVisibility, Mode=OneWay}"
                               Text="该机型下暂无可展示的照片。" />
                </Grid>
            </ScrollViewer>

            <!-- 分组详情 -->
            <ScrollViewer Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                          Padding="20,0,20,20"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- 分组用法提示（仅注册号详情态显示） -->
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Visibility="{x:Bind ViewModel.GroupingHintVisibility, Mode=OneWay}"
                             Message="{x:Bind ViewModel.UserGroupHint, Mode=OneWay}" />

                    <!--
                        时间轴（二层分组）：同一注册号 = 同一架飞机，
                        节点分「自定义分组」与「自动按天」两类，互斥且不重复。

                        轴线布局要点：
                        - 外层 Grid 不设纵向 Margin，否则相邻节点的轴线会断开；
                          间距改由右侧内容 StackPanel 的 Bottom Margin 提供。
                        - 轴线条用 Width=2 的 Border，VerticalAlignment 默认 Stretch 即可贯穿整行。
                        - 圆点用 14x14 + CornerRadius=7 的 Border 做成圆形，
                          再叠一圈 3px 的底色描边，压在轴线上时边缘不会糊。
                    -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.TimelineVisibility, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineNode">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        贯穿整行的垂直轴线。
                                        用色注意：这里不能用 CardStrokeColorDefaultBrush ——
                                        它专供卡片描边，深色主题下只有 ~4 个色阶的对比（实测
                                        背景 (39,39,42) vs 轴线 (35,35,37)），等于画了看不见。
                                        改用 TextFillColorTertiaryBrush 配 50% 不透明度：
                                        既清晰可辨，又比同色的节点圆点弱一档，形成主次。
                                    -->
                                    <Border Grid.Column="0"
                                            Width="2"
                                            Opacity="0.5"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}" />

                                    <!-- 节点圆点：自定义分组（强调色） -->
                                    <Border Grid.Column="0"
                                            Width="14" Height="14"
                                            CornerRadius="7"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,10,0,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="3"
                                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            Visibility="{x:Bind BadgeVisibility}" />

                                    <!-- 节点圆点：按天自动分组（中性色） -->
                                    <Border Grid.Column="0"
                                            Width="14" Height="14"
                                            CornerRadius="7"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,10,0,0"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"
                                            BorderThickness="3"
                                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            Visibility="{x:Bind DayDotVisibility}" />

                                    <StackPanel Grid.Column="1" Margin="10,0,0,26" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Visibility="{x:Bind BadgeVisibility}"
                                                    VerticalAlignment="Center"
                                                    Padding="6,1"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                <TextBlock Text="自定义分组"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind CountText}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,4"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!--
                                            日期下的说明区：
                                            第一行是节点自身说明（星期 / 类型），
                                            之后是节点内每张照片的元信息（一行一张）。
                                            照片卡片上已不再印字，信息统一在这里看。
                                        -->
                                        <StackPanel Spacing="1" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind Subtitle}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind PhotoInfoText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <GridView ItemsSource="{x:Bind Photos}"
                                                  SelectionMode="None"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="OnPhotoClick"
                                                  ItemTemplate="{StaticResource PhotoCardTpl}">
                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Margin" Value="4" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </GridView.ItemContainerStyle>
                                        </GridView>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 平铺照片（未启用二层分组，或时间轴为空时兜底） -->
                    <GridView ItemsSource="{x:Bind ViewModel.Photos, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.FlatPhotosVisibility, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnPhotoClick"
                              ItemTemplate="{StaticResource PhotoCardTpl}">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>
            </ScrollViewer>

            <!-- 空状态 -->
            <TextBlock Margin="24"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="{x:Bind ViewModel.EmptyHintVisibility, Mode=OneWay}"
                       Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" />
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                Padding="20,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
