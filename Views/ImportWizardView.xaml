<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AirPhotoGarage.Views.ImportWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPhotoGarage.Views"
    xmlns:vm="using:AirPhotoGarage.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="vm:ImportWizardViewModel"
    mc:Ignorable="d">

    <!--
        半透明背景覆盖层。按 Fluent Design 规范：使用主题色 + Opacity 0.6 做遮罩，
        避免硬编码 #000000（在亮/暗主题下表现一致且符合系统设计语言）。
    -->
    <Grid Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
        <Rectangle Fill="{ThemeResource ControlAltFillColorTertiaryBrush}"
                   Opacity="0.6" />
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="12"
                Padding="24"
                Width="780"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="导入照片并填写信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StepText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,4"
                            Click="OnCancelClick" />
                </Grid>

                <!-- 主体：缩略图 + 表单 -->
                <Grid Grid.Row="1" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：缩略图 -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            CornerRadius="6"
                            MinHeight="240">
                        <Image Source="{x:Bind ViewModel.CurrentThumbnail, Mode=OneWay}"
                               Stretch="UniformToFill" />
                    </Border>

                    <!-- 右侧：表单 -->
                    <ScrollViewer Grid.Column="1" Margin="16,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="拍摄时间：" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ShotAtText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ExifHint, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />

                            <AutoSuggestBox x:Name="AsbModel" Header="机型（如 Boeing 737-800）"
                                            Text="{x:Bind ViewModel.AircraftModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="输入机型或从候选中选择"
                                            QueryIcon="Find"
                                            TextChanged="OnModelTextChanged" />

                            <TextBox Header="注册号（如 B-1234）"
                                     Text="{x:Bind ViewModel.RegistrationNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="必填" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,4,0"
                                         Header="IATA 三字代码（如 PEK）"
                                         MaxLength="3"
                                         Text="{x:Bind ViewModel.AirportIata, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="4,0,0,0"
                                         Header="ICAO 四字代码（如 ZBAA）"
                                         MaxLength="4"
                                         Text="{x:Bind ViewModel.AirportIcao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                         Header="机场名称（输入后自动回填 IATA/ICAO）"
                                         Text="{x:Bind ViewModel.AirportName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBox Header="备注"
                                     Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="60"
                                     MaxHeight="100" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底部按钮 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal" Spacing="8">
                        <Button Content="取消"
                                Click="OnCancelClick" />
                        <Button Content="上一张"
                                Command="{x:Bind ViewModel.PreviousCommand}"
                                IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
                        <Button Content="复用上一张信息"
                                Command="{x:Bind ViewModel.CopyFromPreviousCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCopyPrevious, Mode=OneWay}"
                                ToolTipService.ToolTip="把上一张已经填好的字段拷贝过来" />
                        <Button Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.NextCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
