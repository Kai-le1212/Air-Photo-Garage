<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AirPhotoGarage.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AirPhotoGarage">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>


            <!--
                GridView 多选勾选框的配色覆盖（原生控件，不改模板）。
                默认配色压在照片上对比度太低 —— 选中时几乎只剩一个勾、看不出框。
                这里把「未选 / 悬停 / 选中」三种状态的底色与描边都改成
                半透明黑底 + 白描边 / 强调色，保证在任何照片上都看得见。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#8C000000" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#B3000000" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#B3000000" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#73000000" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#99000000" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#99000000" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                照片详情弹窗的内容宽度控制在 ~520，落在 WinUI 默认的
                ContentDialog 宽度范围内，因此这里无需覆盖 ContentDialogMaxWidth。
                保留此注释是为了记录踩坑结论：把该键写在 Application.Resources 顶层
                或 dialog.Resources 上都无效（它由 XamlControlsResources 定义在
                ThemeDictionaries 内，主题查找优先级更高）；真正可靠的做法是
                让内容自身不超过窗口可用宽度。
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
