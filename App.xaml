<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AirPhotoGarage.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AirPhotoGarage">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                选头图：候选照片卡片。
                用 ImageBrush 作 Border 的 Background，既能让圆角真正裁到图片（上下左右一致），
                又可以用 UniformToFill 铺满、不留左右黑边。
            -->
            <DataTemplate x:Key="CoverCandidateTpl">
                <Border Width="220"
                        Height="130"
                        Margin="0,0,12,0"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{Binding ImageBrush}" />
            </DataTemplate>

            <!--
                Button 的悬停 / 按下底色：默认很淡，压在照片上看不出来。
                这里只覆盖资源键（不改模板），让「选头图」这类图片按钮有明确的悬停与按下反馈。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8CFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4D000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                照片详情弹窗的内容宽度控制在 ~520，落在 WinUI 默认的
                ContentDialog 宽度范围内，因此这里无需覆盖 ContentDialogMaxWidth。
                保留此注释是为了记录踩坑结论：把该键写在 Application.Resources 顶层
                或 dialog.Resources 上都无效（它由 XamlControlsResources 定义在
                ThemeDictionaries 内，主题查找优先级更高）；真正可靠的做法是
                让内容自身不超过窗口可用宽度。
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
