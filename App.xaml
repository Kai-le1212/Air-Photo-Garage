<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AirPhotoGarage.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AirPhotoGarage">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                选头图：候选照片卡片。
                用 ImageBrush 作 Border 的 Background，既能让圆角真正裁到图片（上下左右一致），
                又可以用 UniformToFill 铺满、不留左右黑边。
            -->
            <DataTemplate x:Key="CoverCandidateTpl">
                <Border Width="220"
                        Height="130"
                        Margin="0,0,12,0"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{Binding ImageBrush}" />
            </DataTemplate>

            <!--
                全应用的悬停 / 按下反馈：默认很淡，压在照片上几乎看不出来。
                只覆盖资源键、不改模板 —— 按钮、列表项、工具栏、导航项统一成同一套强度。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8CFFFFFF" />

                    <!-- 列表 / 网格项（照片卡片、分组磁贴）：悬停与按下的高亮 -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#47FFFFFF" />

                    <!-- 顶部工具栏按钮 -->
                    <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="#59FFFFFF" />

                    <!-- 切换按钮（多选、视图切换） -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#59FFFFFF" />

                    <!-- 左侧导航项 -->
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#38FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4D000000" />

                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#3D000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1F000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33000000" />

                    <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="#3D000000" />

                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#3D000000" />

                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1A000000" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#26000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                照片详情弹窗的内容宽度控制在 ~520，落在 WinUI 默认的
                ContentDialog 宽度范围内，因此这里无需覆盖 ContentDialogMaxWidth。
                保留此注释是为了记录踩坑结论：把该键写在 Application.Resources 顶层
                或 dialog.Resources 上都无效（它由 XamlControlsResources 定义在
                ThemeDictionaries 内，主题查找优先级更高）；真正可靠的做法是
                让内容自身不超过窗口可用宽度。
            -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
