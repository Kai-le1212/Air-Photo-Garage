<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AirPhotoGarage.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPhotoGarage"
    xmlns:vm="using:AirPhotoGarage.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:AirPhotoGarage.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            照片墙卡片模板。
            抽成资源是因为「按注册号分组」与「平铺」两个视图都要用它 ——
            内联写两份会立刻产生漂移，改一处忘一处。

            按 winui3-full-skill/snippets/collections/gridview.md：
            DataTemplate 根元素必须显式 Width/Height，否则 GridViewItem 容器坍缩到 0、卡片完全不可见。
        -->
        <DataTemplate x:Key="WallCardTpl" x:DataType="vm:PhotoCardViewModel">
            <Border Width="240"
                    BorderThickness="1" CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    RightTapped="OnCardRightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 缩略图区域 + 覆盖文字 -->
                    <Grid Grid.Row="0"
                          Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                        <!--
                            高度绑定到按缩略图比例算出的值（CardImageHeight）：
                            框跟着图片走，上下不留空带、也不裁切画面边缘，
                            并且自动适配不同尺寸的照片。
                        -->
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                               Height="{x:Bind CardImageHeight, Mode=OneWay}"
                               Stretch="Uniform" />

                        <!-- 未提供信息覆盖层 -->
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Stretch"
                                Padding="8,4"
                                CornerRadius="0,0,0,8"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                Visibility="{x:Bind HasNoInfo, Mode=OneWay}">
                            <TextBlock Text="未提供机型/注册号信息"
                                       Foreground="White"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </Grid>

                    <!-- 文本信息：主标题统一为注册号 -->
                    <StackPanel Grid.Row="1" Padding="10,10,10,8" Spacing="2">
                        <TextBlock Text="{x:Bind PrimaryDisplay, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind MetaDisplay, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind AirportDisplay, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            注册号窗格：一个注册号 = 一个窗格。
            封面取该注册号第一张照片的缩略图，右上角显示张数；
            点窗格（或「查看照片」按钮）打开弹出面板看全部照片。

            同样必须显式 Width/Height，否则 GridViewItem 容器坍缩到 0。
        -->
        <DataTemplate x:Key="RegistrationTileTpl" x:DataType="vm:RegistrationGroup">
            <Border Width="240"
                    BorderThickness="1" CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Auto：封面高度由图片比例决定，上下不留空 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 封面 + 角标 -->
                    <Grid Grid.Row="0" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                        <Image Source="{x:Bind CoverThumbnail, Mode=OneWay}"
                               Height="{x:Bind CoverHeight, Mode=OneWay}"
                               Stretch="Uniform" />

                        <!-- 张数角标 -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="8" Padding="8,2" CornerRadius="10"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind CountText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!-- 「未填写注册号」兜底窗格 -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Padding="8,4" CornerRadius="0,0,8,0"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                Visibility="{x:Bind MissingBadgeVisibility}">
                            <TextBlock Text="未填写注册号"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="White" />
                        </Border>
                    </Grid>

                    <!-- 文字信息 -->
                    <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                        <TextBlock Text="{x:Bind Title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 机型 / 时间范围 / 机场（单个派生属性，避免 DataTemplate 内 <Run> 的 WMC1111 问题） -->
                        <TextBlock Text="{x:Bind SummaryText}" MaxLines="2"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 常驻入口：不依赖 ItemClick 命中测试是否可靠 -->
                        <Button Content="查看照片"
                                Padding="8,2" Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Click="OnRegistrationOpenButtonClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Label="导入照片" Icon="Add" Click="OnImportClick" />
            <AppBarButton Label="刷新" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarSeparator />
            <AppBarToggleButton Label="按注册号分组"
                                IsChecked="{x:Bind ViewModel.GroupByRegistration, Mode=TwoWay}"
                                AutomationProperties.Name="按注册号分组">
                <AppBarToggleButton.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator />
            <AppBarButton Label="清空筛选" Icon="Clear" Command="{x:Bind ViewModel.ClearFilterCommand}" />
        </CommandBar>

        <!-- 主区：左侧筛选 + 右侧照片墙 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 筛选面板 -->
            <Border Grid.Column="0"
                    Padding="16"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="筛选" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBox Header="关键词（机型 / 注册号 / 机场 / 备注）"
                                 Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnFilterChanged" />

                        <!--
                            注意：TokenizingTextBox 的 ItemsSource 是「已选 token 集合」，
                            自动补全候选必须挂到 SuggestedItemsSource，否则下拉框永远不会出现。
                        -->
                        <controls:TokenizingTextBox x:Name="TtbAircraft"
                                                    Header="机型"
                                                    PlaceholderText="选择或输入机型"
                                                    SuggestedItemsSource="{x:Bind ViewModel.AircraftSuggestions}"
                                                    SuggestionChosen="OnSuggestionChosen"
                                                    QuerySubmitted="OnQuerySubmitted"
                                                    TextChanged="OnTokenTextChanged"
                                                    TokenItemAdded="OnTokenChanged"
                                                    TokenItemRemoved="OnTokenChanged" />

                        <controls:TokenizingTextBox x:Name="TtbRegistration"
                                                    Header="注册号"
                                                    PlaceholderText="如 B-1234"
                                                    SuggestedItemsSource="{x:Bind ViewModel.RegistrationSuggestions}"
                                                    SuggestionChosen="OnSuggestionChosen"
                                                    QuerySubmitted="OnQuerySubmitted"
                                                    TextChanged="OnTokenTextChanged"
                                                    TokenItemAdded="OnTokenChanged"
                                                    TokenItemRemoved="OnTokenChanged" />

                        <controls:TokenizingTextBox x:Name="TtbAirport"
                                                    Header="机场代码"
                                                    PlaceholderText="如 ZBAA"
                                                    SuggestedItemsSource="{x:Bind ViewModel.AirportSuggestions}"
                                                    SuggestionChosen="OnSuggestionChosen"
                                                    QuerySubmitted="OnQuerySubmitted"
                                                    TextChanged="OnTokenTextChanged"
                                                    TokenItemAdded="OnTokenChanged"
                                                    TokenItemRemoved="OnTokenChanged" />

                        <CalendarDatePicker Header="拍摄起始日期"
                                            PlaceholderText="选择起始日期"
                                            Date="{x:Bind ViewModel.ShotFrom, Mode=TwoWay}"
                                            DateChanged="OnCalendarDateChanged" />

                        <CalendarDatePicker Header="拍摄结束日期"
                                            PlaceholderText="选择结束日期"
                                            Date="{x:Bind ViewModel.ShotTo, Mode=TwoWay}"
                                            DateChanged="OnCalendarDateChanged" />

                        <ComboBox Header="排序方式"
                                  ItemsSource="{x:Bind ViewModel.SortOptions}"
                                  SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />

                        <Button Content="应用筛选"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnApplyFilter" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 照片墙 -->
            <Grid Grid.Column="1" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="4,0,0,8"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <!--
                        注册号视图：每个注册号【只占一个窗格】（封面 + 张数 + 摘要），
                        点窗格才在弹出面板里展开这架飞机的全部照片 ——
                        照片多的时候，一屏能看完整机队，而不是被同型机的几十张照片淹没。

                        窗格顺序沿用该组首张照片在当前排序里的位置，自动跟随左侧「排序方式」。
                    -->
                    <GridView ItemsSource="{x:Bind ViewModel.RegistrationGroups, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.GroupedWallVisibility, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnRegistrationTileClick"
                              ItemTemplate="{StaticResource RegistrationTileTpl}"
                              AutomationProperties.Name="注册号">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <!--
                        按 winui3-full-skill/snippets/collections/gridview.md 推荐：
                        照片墙用 GridView 而不是 ItemsRepeater，自带 ItemClick 标准事件。
                        - SelectionMode=None + IsItemClickEnabled=True → 点击触发 ItemClick（详情）
                        - 右键（RightTapped）触发菜单
                        - DataTemplate 内不再用 Button 包裹，避免事件路由不可靠
                    -->
                    <GridView ItemsSource="{x:Bind ViewModel.Photos, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.FlatWallVisibility, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnPhotoItemClick"
                              ItemTemplate="{StaticResource WallCardTpl}"
                              AutomationProperties.Name="照片墙">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Padding="12,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="16" Height="16" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- 导入向导覆盖层（始终在顶层） -->
        <views:ImportWizardView Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</Page>
