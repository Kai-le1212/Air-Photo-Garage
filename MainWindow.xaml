<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AirPhotoGarage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirPhotoGarage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AirPhotoGarage"
    mc:Ignorable="d">

    <!--
        自绘标题栏：ExtendsContentIntoTitleBar 之后系统标题栏被隐藏，
        顶部这条由 XAML 画 —— 这样主题（深/浅）与左上角 logo 都完全可控。
        右侧留出 150px 给系统的最小化/最大化/关闭按钮。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 32 = 系统最小化/最大化/关闭按钮的高度；高度不一致时左边标题会偏下 -->
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="14,0,140,0">
            <!--
                高度 32 与系统窗口按钮一致（上下对齐）；内容靠左排，
                右侧留 140px 给最小化/最大化/关闭按钮，避免被压住。
            -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Spacing="10">
                <Image Source="Assets/Square44x44Logo.scale-200.png"
                       Width="24"
                       Height="24"
                       AutomationProperties.Name="应用图标" />
                <TextBlock Text="Air Photo Garage"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                    x:Name="NavView"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Auto"
                    ItemInvoked="NavView_ItemInvoked"
                    Loaded="NavView_Loaded">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="照片墙"
                                Tag="gallery"
                                AutomationProperties.Name="照片墙">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="机型"
                                Tag="aircraft"
                                AutomationProperties.Name="机型">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE709;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="机场"
                                Tag="airport"
                                AutomationProperties.Name="机场">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE707;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="航司"
                                Tag="airline"
                                AutomationProperties.Name="航司">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="注册号"
                                Tag="registration"
                                AutomationProperties.Name="注册号">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8AC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="设置"
                                Tag="settings"
                                AutomationProperties.Name="设置">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
